# Copy to apps/api/.env and adjust. Every variable is optional: src/config.ts
# falls back to the values below, so the API also runs with an empty
# environment.

# HTTP port of the integrations API
PORT=3000

# Comma-separated browser origins allowed to call the API (CORS)
CORS_ORIGINS=http://localhost:5173

# Upstream base URLs
PVOG_SEARCH_BASE_URL=https://pvog.fitko.net/suchdienst/api
FIM_PORTAL_BASE_URL=https://fimportal.de/api

# Upstream version of the PVOG service search behind GET /services:
# v7 (production default) or v8beta1 (supported experimental adapter).
# Any other value stops the API at startup.
PVOG_SERVICE_SEARCH_VERSION=v7

# Budget of one outbound upstream request in milliseconds, including
# retries and the waits between them. The request is aborted at the
# budget's deadline whatever it is doing and answered as a timeout.
INTEGRATIONS_HTTP_TIMEOUT_MS=15000

# Retries after the initial attempt for network failures and HTTP
# 429/502/503/504 (0 disables retrying) and the bounds of the backoff
# between attempts (exponential with jitter). A valid Retry-After on
# 429/503 replaces the computed delay.
INTEGRATIONS_HTTP_MAX_RETRIES=2
INTEGRATIONS_HTTP_RETRY_BASE_DELAY_MS=200
INTEGRATIONS_HTTP_RETRY_MAX_DELAY_MS=2000

# Circuit breaker (opossum), one per provider (PVOG, FIM). The circuit opens
# when, within the rolling window, at least VOLUME_THRESHOLD calls were made
# and more than ERROR_THRESHOLD_PERCENTAGE of them failed with an
# availability failure (network failure, timeout, 5xx). It stays open for
# RESET_TIMEOUT_MS, then lets exactly one probe call through.
INTEGRATIONS_BREAKER_ERROR_THRESHOLD_PERCENTAGE=50
INTEGRATIONS_BREAKER_VOLUME_THRESHOLD=5
INTEGRATIONS_BREAKER_ROLLING_WINDOW_MS=10000
INTEGRATIONS_BREAKER_RESET_TIMEOUT_MS=30000

# In-process cache (lru-cache) for key-based, rarely changing reads
# (territory by regional key, catalog entry, master text, organisation
# unit); searches and enumerations are never cached. Bounded by entry count
# and by the lifetime of an entry in milliseconds.
INTEGRATIONS_CACHE_ENABLED=true
INTEGRATIONS_CACHE_MAX_ENTRIES=1000
INTEGRATIONS_CACHE_TTL_MS=300000
