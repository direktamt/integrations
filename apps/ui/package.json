{
  "name": "@direktamt/integrations-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Developer-facing inspection console for the DirektAmt integrations API.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
